DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/pair_db

# AI provider secrets: SERVER SIDE ONLY. Never expose these to Next.js/browser.
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_FALLBACK_MODELS=

DEFAULT_AI_PROVIDER=nvidia
DEFAULT_AI_MODEL=openai/gpt-oss-20b

MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# Security
REQUIRE_AUTH=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_MB=55

# Optional infrastructure
REDIS_URL=
CACHE_TTL_SECONDS=60

APP_NAME=PAIR Backend
APP_VERSION=3.0.0
DEBUG=false
